{
  "name": "spruce-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Marketing site for the spruce terminal-UI kit.",
  "scripts": {
    "generate": "npm run generate:code && npm run generate:terminal",
    "generate:code": "node tools/generate-code-samples.mjs",
    "generate:terminal": "node tools/generate-terminal-blocks.mjs",
    "build:gleam": "cd workbench && gleam build --target javascript",
    "check:gleam": "cd workbench && node check.mjs",
    "predev": "npm run generate:code && npm run build:gleam",
    "dev": "vite",
    "prebuild": "npm run generate:code && npm run build:gleam",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretest": "npm run build:gleam",
    "test": "node --test tools/ansi2html.test.js && node --experimental-strip-types --test tools/workbench.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.2",
    "expressive-code": "^0.44.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^8.0.16"
  }
}
